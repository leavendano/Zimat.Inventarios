@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject DialogService DialogService
@inject ContextMenuService ContextMenuService
@inject TooltipService TooltipService
@inject NotificationService NotificationService
<RadzenComponents @rendermode="InteractiveAuto" />

<RadzenLayout style="grid-template-areas: 'rz-sidebar rz-header' 'rz-sidebar rz-body';">
    <RadzenHeader>
        <RadzenRow  Gap="0">
            <RadzenColumn Size="2">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="0" > 
                    <RadzenSidebarToggle Click="@SidebarToggleClick"></RadzenSidebarToggle>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="10px"> 
                   <LogInOrOut/>
                </RadzenStack>  
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>
    
    <RadzenSidebar Responsive="true" Style="width: max-content">
        <RadzenStack AlignItems="Radzen.AlignItems.Center" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding); border-bottom: var(--rz-panel-menu-item-border);">
            <RadzenImage Path="images/logo_zimat.png"  style="width: 200px; height: 200px;" AlternateText="Application logo"></RadzenImage>
            <RadzenText Text="ZIMAT.Inventarios.Web" TextStyle="Radzen.Blazor.TextStyle.Subtitle1" class="rz-mb-0" style="color: var(--rz-sidebar-color);" />
        </RadzenStack>
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="false">
            <RadzenPanelMenuItem Text="General" Icon="home">
                <RadzenPanelMenuItem Text="Inicio" Path="" Icon="account_circle"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Usuarios" Path="usuarios" Icon="account_circle"></RadzenPanelMenuItem>
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Ventas" Icon="payment">
                <RadzenPanelMenuItem Text="Clientes" Path="clientes" Icon="check_circle"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Vendedores" Path="usuarios" Icon="input"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Registro de Ventas" Path="punto_venta" Icon="description"></RadzenPanelMenuItem>
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Inventarios" Icon="save">
                <RadzenPanelMenuItem Text="Catálogo de Artículos y Servicios" Path="list_articulos" Icon="grid_on"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Unidades" Path="unidades" Icon="list"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Reportes" Path="dropdown" Icon="dns"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Clasificaciones" Icon="receipt">
                    <RadzenPanelMenuItem Text="Linea" Path="lineas" Icon="list"></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Text="Familia" Path="familias" Icon="dns"></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Text="Categoria" Path="categorias" Icon="list"></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Text="Departamentos" Path="departamentos" Icon="dns"></RadzenPanelMenuItem>
                    <RadzenPanelMenuItem Text="Marcas" Path="marcas" Icon="dns"></RadzenPanelMenuItem>
                </RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Actualizar Precios" Path="listbox" Icon="view_list"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Tipos de Movimientos" Path="tipo-documentos" Icon="line_style"></RadzenPanelMenuItem>
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Compras" Icon="save">
                <RadzenPanelMenuItem Text="Proveedores" Path="proveedores" Icon="grid_on"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Registro de Compras" Path="compras" Icon="list"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Devoluciones" Path="dropdown" Icon="dns"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="Clasificaciones" Path="dropdown-datagrid" Icon="receipt"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="ListBox" Path="listbox" Icon="view_list"></RadzenPanelMenuItem>
                <RadzenPanelMenuItem Text="TemplateForm" Path="templateform" Icon="line_style"></RadzenPanelMenuItem>
            </RadzenPanelMenuItem>
        </RadzenPanelMenu>
        <RadzenStack AlignItems="Radzen.AlignItems.Center" Gap="0" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding);">
            <RadzenText Text="ZIMAT.Inventarios.Web v1.0.0" TextStyle="Radzen.Blazor.TextStyle.Caption" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
            <RadzenText Text="Copyright Ⓒ 2024" TextStyle="Radzen.Blazor.TextStyle.Caption" class="rz-mb-0" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
        </RadzenStack>
    </RadzenSidebar>
    <RadzenBody >
        <RadzenRow class="rz-mx-auto rz-px-4 rz-pt-2 rz-pt-md-4 rz-pt-lg-6 rz-pt-xl-12 rz-pb-2 rz-pb-lg-12" Style="max-width: 1440px;">
            <RadzenColumn Size="12">
            @Body
            </RadzenColumn>
        </RadzenRow>
    </RadzenBody>
    <RadzenFooter>
        
    </RadzenFooter>
</RadzenLayout>

@code {
    bool sidebarExpanded = true;
    string searchText = "";
    
   

    void SidebarToggleClick()
    {
        sidebarExpanded = !sidebarExpanded;
    }

    void Search()
    {
        // Implementar la lógica de búsqueda según la categoría seleccionada
        
        NavigationManager.NavigateTo($"/punto_venta?search={searchText}");
               
        
    }
}
