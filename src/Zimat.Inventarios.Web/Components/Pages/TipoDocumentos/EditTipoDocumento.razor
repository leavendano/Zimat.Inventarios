@page "/edit-tipo-documento"
@using MediatR
@using Zimat.Inventarios.UseCases.TipoDocumentos.Get
@using Zimat.Inventarios.UseCases.TipoDocumentos.Update
@inject IMediator _mediator
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ILogger<EditTipoDocumento> logger

<PageTitle>Editar Tipo de Documento</PageTitle>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">@mensajeAlerta</RadzenAlert>
    <RadzenTemplateForm TItem="TipoDocumentoFormDTO" Data="@tipoDocumento" Visible="@(tipoDocumento != null)" Submit="@FormSubmit">
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Nombre" Component="nombre" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenTextBox style="display: block; width: 100%" @bind-Value="@tipoDocumento!.Nombre" Name="nombre" />
                <RadzenRequiredValidator Component="nombre" Text="El nombre es requerido" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Prefijo" Component="prefijo" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenTextBox style="display: block; width: 100%" @bind-Value="@tipoDocumento!.Prefijo" Name="prefijo" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Último Folio" Component="ultimoFolio" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenNumeric Name="ultimoFolio" @bind-Value="@tipoDocumento!.UltimoFolio" Style="width: 100%;" Min="0" Disabled="true" />
                <RadzenText TextStyle="TextStyle.Caption" style="display: block; margin-top: 0.25rem">El último folio no se puede modificar desde aquí</RadzenText>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="6">
                <RadzenCheckBox @bind-Value="@tipoDocumento!.EsEntrada" Name="esEntrada" />
                <RadzenLabel Text="Es Entrada" Component="esEntrada" style="margin-left: 0.5rem" />
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenCheckBox @bind-Value="@tipoDocumento!.EsSalida" Name="esSalida" />
                <RadzenLabel Text="Es Salida" Component="esSalida" style="margin-left: 0.5rem" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="6">
                <RadzenCheckBox @bind-Value="@tipoDocumento!.AfectaInventario" Name="afectaInventario" />
                <RadzenLabel Text="Afecta Inventario" Component="afectaInventario" style="margin-left: 0.5rem" />
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenCheckBox @bind-Value="@tipoDocumento!.AfectaCuentasPorPagar" Name="afectaCuentasPorPagar" />
                <RadzenLabel Text="Afecta Cuentas por Pagar" Component="afectaCuentasPorPagar" style="margin-left: 0.5rem" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="6">
                <RadzenCheckBox @bind-Value="@tipoDocumento!.AfectaCuentasPorCobrar" Name="afectaCuentasPorCobrar" />
                <RadzenLabel Text="Afecta Cuentas por Cobrar" Component="afectaCuentasPorCobrar" style="margin-left: 0.5rem" />
            </RadzenColumn>
            <RadzenColumn SizeMD="6">
                <RadzenCheckBox @bind-Value="@tipoDocumento!.RequiereProveedor" Name="requiereProveedor" />
                <RadzenLabel Text="Requiere Proveedor" Component="requiereProveedor" style="margin-left: 0.5rem" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="6">
                <RadzenCheckBox @bind-Value="@tipoDocumento!.RequiereCliente" Name="requiereCliente" />
                <RadzenLabel Text="Requiere Cliente" Component="requiereCliente" style="margin-left: 0.5rem" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Guardar" Variant="Variant.Flat" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancelar" Variant="Variant.Flat" Click="@CancelButtonClick" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>

@code{
    protected class TipoDocumentoFormDTO
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Prefijo { get; set; } = string.Empty;
        public int UltimoFolio { get; set; } = 0;
        public bool EsEntrada { get; set; } = false;
        public bool EsSalida { get; set; } = false;
        public bool AfectaInventario { get; set; } = false;
        public bool AfectaCuentasPorPagar { get; set; } = false;
        public bool AfectaCuentasPorCobrar { get; set; } = false;
        public bool RequiereProveedor { get; set; } = false;
        public bool RequiereCliente { get; set; } = false;
    }

    [Parameter]
    public int Id { get; set; }

    [Parameter] public EventCallback OnTipoDocumentoUpdated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await _mediator.Send(new GetTipoDocumentoQuery(Id));
        if (result.IsSuccess)
        {
            tipoDocumento.Id = result.Value.Id;
            tipoDocumento.Nombre = result.Value.Nombre;
            tipoDocumento.Prefijo = result.Value.Prefijo;
            tipoDocumento.UltimoFolio = result.Value.UltimoFolio;
            tipoDocumento.EsEntrada = result.Value.EsEntrada;
            tipoDocumento.EsSalida = result.Value.EsSalida;
            tipoDocumento.AfectaInventario = result.Value.AfectaInventario;
            tipoDocumento.AfectaCuentasPorPagar = result.Value.AfectaCuentasPorPagar;
            tipoDocumento.AfectaCuentasPorCobrar = result.Value.AfectaCuentasPorCobrar;
            tipoDocumento.RequiereProveedor = result.Value.RequiereProveedor;
            tipoDocumento.RequiereCliente = result.Value.RequiereCliente;
        }
        else
        {
            mensajeAlerta = "No se pudo cargar el tipo de documento";
            errorVisible = true;
        }
    }

    protected bool errorVisible;
    protected string mensajeAlerta = "No se pudo guardar el registro";

    protected TipoDocumentoFormDTO tipoDocumento { get; set; } = new();

    protected async Task FormSubmit()
    {
        try
        {
            var result = await _mediator.Send(new UpdateTipoDocumentoCommand(
                tipoDocumento.Id,
                tipoDocumento.Nombre,
                tipoDocumento.EsEntrada,
                tipoDocumento.EsSalida,
                tipoDocumento.AfectaInventario,
                tipoDocumento.AfectaCuentasPorPagar,
                tipoDocumento.AfectaCuentasPorCobrar,
                tipoDocumento.RequiereProveedor,
                tipoDocumento.RequiereCliente,
                tipoDocumento.Prefijo
            ));

            if (result.IsSuccess)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Tipo de documento actualizado",
                    Detail = "El tipo de documento se ha actualizado correctamente",
                    Duration = 4000
                });

                if (OnTipoDocumentoUpdated.HasDelegate)
                {
                    await OnTipoDocumentoUpdated.InvokeAsync();
                }

                DialogService.Close(tipoDocumento);
            }
            else
            {
                mensajeAlerta = "No se pudo actualizar el tipo de documento";
                errorVisible = true;
            }
        }
        catch (Exception e)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al actualizar el tipo de documento",
                Detail = e.Message,
                Duration = 4000
            });
            mensajeAlerta = $"Error: {e.Message}";
            errorVisible = true;
            logger.LogError(e, "Error al actualizar el tipo de documento");
        }
    }

    protected async Task CancelButtonClick(MouseEventArgs args)
    {
        await Task.Run(() => DialogService.Close(null));
    }
}
