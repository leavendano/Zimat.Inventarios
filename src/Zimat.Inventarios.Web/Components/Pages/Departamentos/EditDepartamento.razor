@page "/edit-departamento"
@using MediatR
@using Zimat.Inventarios.UseCases.Departamentos.Get
@using Zimat.Inventarios.UseCases.Departamentos.Update
@inject IMediator _mediator
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ILogger<EditDepartamento> logger

<PageTitle>Editar Departamento</PageTitle>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">@mensajeAlerta</RadzenAlert>
    <RadzenTemplateForm TItem="DepartamentoDTO" Data="@departamento" Visible="@(departamento != null)" Submit="@FormSubmit">
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Nombre" Component="nombre" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenTextBox style="display: block; width: 100%" @bind-Value="@departamento!.Nombre" Name="nombre" />
                <RadzenRequiredValidator Component="nombre" Text="El nombre es requerido" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Guardar" Variant="Variant.Flat" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancelar" Variant="Variant.Flat" Click="@CancelButtonClick" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>

@code{
    protected class DepartamentoDTO
    {
        public Guid Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    [Parameter]
    public Guid Id { get; set; }

    [Parameter] public EventCallback OnDepartamentoUpdated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await _mediator.Send(new GetDepartamentoQuery(Id));
        if (result.IsSuccess)
        {
            departamento.Id = result.Value.Id;
            departamento.Nombre = result.Value.Nombre;
        }
        else
        {
            mensajeAlerta = "No se pudo cargar el departamento";
            errorVisible = true;
        }
    }

    protected bool errorVisible;
    protected string mensajeAlerta = "No se pudo guardar el registro";

    protected DepartamentoDTO departamento { get; set; } = new();

    protected async Task FormSubmit()
    {
        try
        {
            var result = await _mediator.Send(new UpdateDepartamentoCommand(departamento.Id, departamento.Nombre));

            if (result.IsSuccess)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Departamento actualizado",
                    Detail = "El departamento se ha actualizado correctamente",
                    Duration = 4000
                });

                if (OnDepartamentoUpdated.HasDelegate)
                {
                    await OnDepartamentoUpdated.InvokeAsync();
                }

                DialogService.Close(departamento);
            }
            else
            {
                mensajeAlerta = "No se pudo actualizar el departamento";
                errorVisible = true;
            }
        }
        catch (Exception e)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error al actualizar el departamento",
                Detail = e.Message,
                Duration = 4000
            });
            mensajeAlerta = $"Error: {e.Message}";
            errorVisible = true;
            logger.LogError(e, "Error al actualizar el departamento");
        }
    }

    protected async Task CancelButtonClick(MouseEventArgs args)
    {
        await Task.Run(() => DialogService.Close(null));
    }
}
