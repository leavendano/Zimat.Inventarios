@page "/carrito"
@using Zimat.Inventarios.UseCases.Compras
@using Zimat.Inventarios.UseCases.Compras.Create
@using Zimat.Inventarios.UseCases.Ventas
@using Zimat.Inventarios.UseCases.Ventas.Create
@using Zimat.Inventarios.Web.Services
@using Zimat.Inventarios.UseCases.Clientes.List
@using Zimat.Inventarios.UseCases.Clientes
@using MediatR
@using Ardalis.Result
@inject CartService CartService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@inject IMediator _mediator
@attribute [Authorize]
@implements IDisposable
<PageTitle>Carrito de Compras</PageTitle>

<RadzenRow>
    <RadzenColumn Size="12">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
            <RadzenButton Icon="arrow_back" 
                        ButtonStyle="ButtonStyle.Light" 
                        Click="@GoBack" 
                        Text="Volver" />
            <RadzenText TextStyle="TextStyle.H4" Text="Carrito de Compras" />
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{CartService.TotalItems} artículos")" />
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

<RadzenRow>
    <RadzenColumn Size="12">
        <RadzenCard class="rz-mb-4">
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6" Text="Seleccionar Cliente" />
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="8">
                        <RadzenDropDown @bind-Value="selectedClienteId"
                                       Data="@clientes"
                                       TextProperty="Nombre"
                                       ValueProperty="Id"
                                       Placeholder="Seleccione un cliente..."
                                       Style="width: 100%;"
                                       Change="@OnClienteSelected" />
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        
                        @if (selectedCliente != null)
                        {
                            <RadzenText TextStyle="TextStyle.Body2" Text="@($"RFC: {selectedCliente.Rfc}")" />
                        }

                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenDropDown @bind-Value="selectedTipoDePago"
                                        Data="@tiposDePago"
                                        Placeholder="Tipo de Pago"
                                        Style="width: 100%;" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenRow>
    <RadzenColumn Size="12">
        @if (CartService.Items.Any())
        {
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    @foreach (var item in CartService.Items)
                    {
                        
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="5">
                               
                                    <RadzenText TextStyle="TextStyle.Body1" Text="@item.Descripcion" />
                                
                            </RadzenColumn>
                            <RadzenColumn Size="2" class="rz-text-align-center">
                                <RadzenText TextStyle="TextStyle.Body1" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", item.PrecioUnitario)}")" />
                            </RadzenColumn>
                            <RadzenColumn Size="2">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenButton Icon="@(item.Cantidad <=1 ? "delete" : "remove")" 
                                                ButtonStyle="ButtonStyle.Dark" Variant="Variant.Outlined"
                                                Click="@(() => UpdateQuantity(item.ArticuloId, item.Cantidad - 1))"  />
                                    <RadzenNumeric @bind-Value="item.Cantidad" 
                                                Min="1" ShowUpDown="false"
                                                Change="@((decimal value) => UpdateQuantity(item.ArticuloId, value))" 
                                                Style="width: 100px;" />
                                    <RadzenButton Icon="add" 
                                                ButtonStyle="ButtonStyle.Dark" Variant="Variant.Outlined"
                                                Click="@(() => UpdateQuantity(item.ArticuloId, item.Cantidad + 1))" />
                                </RadzenStack>
                            </RadzenColumn>
                            <RadzenColumn Size="2" class="rz-text-align-center">
                                
                                   
                                    <RadzenText TextStyle="TextStyle.Body1" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", item.Total)}")" />
                                
                            </RadzenColumn>
                            <RadzenColumn Size="1" class="rz-text-align-center">
                                <RadzenButton Icon="delete" 
                                            ButtonStyle="ButtonStyle.Danger" 
                                            Click="@(args => RemoveFromCart(item.ArticuloId))"  />
                            </RadzenColumn>
                        </RadzenRow>
                        
                    }
                </RadzenStack>
            </RadzenCard>
            
            <RadzenCard class="rz-mt-4">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H5" Text="Resumen de la Compra" />
                    
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.Body1" Text="Subtotal:" />
                        </RadzenColumn>
                        <RadzenColumn Size="6" class="rz-text-align-end">
                            <RadzenText TextStyle="TextStyle.Body1" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", CartService.Subtotal)}")" />
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.Body1" Text="Impuestos:" />
                        </RadzenColumn>
                        <RadzenColumn Size="6" class="rz-text-align-end">
                            <RadzenText TextStyle="TextStyle.Body1" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", CartService.TotalImpuestos)}")" />
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <div style="border-top: 2px solid #ccc; margin: 1rem 0;"></div>
                    
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenText TextStyle="TextStyle.H5" Text="Total:" />
                        </RadzenColumn>
                        <RadzenColumn Size="6" class="rz-text-align-end">
                            <RadzenText TextStyle="TextStyle.H5" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", CartService.Total)}")" />
                        </RadzenColumn>
                    </RadzenRow>
                    
                    <div style="border-top: 1px solid #ccc; margin: 1rem 0;"></div>
                    
                    <RadzenRow>
                        <RadzenColumn Size="6">
                            <RadzenButton Text="Limpiar Carrito" 
                                        ButtonStyle="ButtonStyle.Light" 
                                        Click="@ClearCart" 
                                        Style="width: 100%;" />
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenButton Text="Procesar Venta" 
                                        ButtonStyle="ButtonStyle.Success" 
                                        Click="@ProcessSale" 
                                        Style="width: 100%;" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenStack>
            </RadzenCard>
        }
        else
        {
            <RadzenCard>
                <RadzenStack AlignItems="AlignItems.Center" Gap="2rem" Style="padding: 3rem;">
                    <RadzenIcon Icon="shopping_cart" Style="font-size: 4rem; color: #ccc;" />
                    <RadzenText TextStyle="TextStyle.H5" Text="El carrito está vacío" class="rz-text-align-center" />
                    <RadzenText TextStyle="TextStyle.Body1" Text="Agrega algunos productos desde el punto de venta" class="rz-text-align-center" />
                    <RadzenButton Text="Ir al Punto de Venta" 
                                ButtonStyle="ButtonStyle.Primary" 
                                Click="@GoToPointOfSale" />
                </RadzenStack>
            </RadzenCard>
        }
    </RadzenColumn>
</RadzenRow>

@code {
    private IEnumerable<ClienteDTO>? clientes;
    private Guid? selectedClienteId;
    private ClienteDTO? selectedCliente;
    List<VentaConceptoDTO> conceptosToSave = [];
    private string[] tiposDePago = new[] { "Contado", "Crédito" };
    private int idTipoDePago = 0; // 0: Contado, 1: Crédito
    private string selectedTipoDePago = "Contado";

    protected override async Task OnInitializedAsync()
    {
        CartService.OnCartChanged += StateHasChanged;
        await LoadClientes();
    }
    
    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }

    private void RemoveFromCart(Guid articuloId)
    {
        CartService.RemoveItem(articuloId);
        NotificationService.Notify(new NotificationMessage 
        { 
            Severity = NotificationSeverity.Info, 
            Summary = "Removido", 
            Detail = "Artículo removido del carrito" 
        });
    }
    
    private void UpdateQuantity(Guid articuloId, decimal cantidad)
    {
        if (cantidad < 1)
        {
            RemoveFromCart(articuloId);
            return;
        }
        CartService.UpdateQuantity(articuloId, cantidad);
    }
    
    private void ClearCart()
    {
        CartService.Clear();
        NotificationService.Notify(new NotificationMessage 
        { 
            Severity = NotificationSeverity.Info, 
            Summary = "Carrito", 
            Detail = "Carrito limpiado" 
        });
    }
    
    private async Task ProcessSale()
    {
        if (!CartService.Items.Any())
        {
            NotificationService.Notify(new NotificationMessage 
            { 
                Severity = NotificationSeverity.Warning, 
                Summary = "Carrito vacío", 
                Detail = "No hay artículos en el carrito para procesar la venta" 
            });
            return;
        }
        
        conceptosToSave = CartService.Items.Select(item => new VentaConceptoDTO
        {
            ArticuloId = item.ArticuloId,
            Cantidad = item.Cantidad,
            Precio = item.PrecioUnitario,
           // UltimoCosto = item.UltimoCosto,
            Impuesto1 = item.Impuesto1,
            Descripcion = item.Descripcion,
            Importe = item.Total
        }).ToList();
        idTipoDePago = selectedTipoDePago == "Contado" ? 51 : 52;
        decimal total = CartService.Total;
        string folio = $"FV-{DateTime.UtcNow:MMddHHmmss}";
        var result = await _mediator.Send(new CreateVentaCommand(folio, DateTime.UtcNow, idTipoDePago, selectedClienteId,
             total, conceptosToSave));
       
       if (result.IsSuccess)
        {
            NotificationService.Notify(new NotificationMessage 
            { 
                Severity = NotificationSeverity.Success, 
                Summary = "Venta procesada", 
                Detail = $"Venta procesada con folio {folio}" 
            });
            ClearCart();
            GoToPointOfSale();
        }
        else
        {
            NotificationService.Notify(new NotificationMessage 
            { 
                Severity = NotificationSeverity.Error, 
                Summary = "Error", 
                Detail = "Error al procesar la venta" 
            });
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/punto_venta");
    }
    
    private void GoToPointOfSale()
    {
        Navigation.NavigateTo("/punto_venta");
    }

    private async Task LoadClientes()
    {
        try
        {
            var result = await _mediator.Send(new ListClientesQuery(null, null, null));
            if (result.IsSuccess)
            {
                clientes = result.Value;
            }
        }
        catch (Exception)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = "Error al cargar los clientes"
            });
        }
    }

    private void OnClienteSelected(object value)
    {
        if (value != null && Guid.TryParse(value.ToString(), out var clienteId))
        {
            selectedClienteId = clienteId;
            selectedCliente = clientes?.FirstOrDefault(c => c.Id == clienteId);

            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Info,
                Summary = "Cliente seleccionado",
                Detail = $"Cliente: {selectedCliente?.Nombre}"
            });
        }
    }
}