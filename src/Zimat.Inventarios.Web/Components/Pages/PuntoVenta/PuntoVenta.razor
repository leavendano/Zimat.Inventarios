@page "/punto_venta"
@using Ardalis.Result
@using Zimat.Inventarios.Core.Base
@using Zimat.Inventarios.UseCases.Articulos
@inject ContextMenuService ContextMenuService
@inject TooltipService TooltipService
@inject NotificationService NotificationService
@inject ILogger<PuntoVenta> logger
@using MediatR
@inject IMediator _mediator
@using Zimat.Inventarios.UseCases.Articulos.Delete
@using Zimat.Inventarios.UseCases.Articulos.List
@using Zimat.Inventarios.Web.Services
@inject CartService CartService
@attribute [Authorize]
@implements IDisposable
<PageTitle>Punto de Venta</PageTitle>

<RadzenRow>
    <RadzenColumn Size="12">
         <RadzenTextBox Placeholder="Buscar..." 
                                 @bind-Value="@searchText" 
                                 Change="@(args => Search())" 
                                 Style="width: 600px;" />
                    <RadzenButton Icon="search" 
                                ButtonStyle="ButtonStyle.Primary" 
                                Click="@Search"/>
    </RadzenColumn>
</RadzenRow>

<RadzenRow>
    <RadzenColumn Size="8">
        <RadzenDataList WrapItems="true" AllowPaging="false" Data="@articulos" TItem="ArticuloListarDTO" Style="display:flex; flex-wrap:wrap; gap:15px;">
            <Template Context="articulo">
                <RadzenCard  Style="width:200px; height:400px; display:flex; flex-direction:column; padding:0; flex-shrink:0;" class="rz-py-0 rz-px-0" >
                    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" Style="flex-grow:1;">
                        <RadzenImage Path="@articulo.RutaImagen" AlternateText="@(articulo.Descripcion)" Style="width:100%; height:200px; object-fit:cover;" />
                        <RadzenStack Gap="0" Style="text-align:center; flex-grow:1; justify-content:center; padding:10px;">
                            <RadzenText TextStyle="TextStyle.Body1" Style="font-weight:normal; overflow:hidden; text-overflow:ellipsis; white-space:normal; max-width:200px;">@(articulo?.Descripcion)</RadzenText>
                            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Left" Style="width:100%;">
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-display-flex rz-mt-2 rz-mb-0">Clave</RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Caption">@(articulo.Clave)</RadzenText>
                                </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Left" Style="width:100%;">
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-display-flex rz-mt-2 rz-mb-0">Disponible</RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Caption">@(articulo.StockActual)</RadzenText>
                                </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Left" Style="width:100%;">
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-display-flex rz-mt-2 rz-mb-0">Precio</RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Caption">@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", articulo.PrecioPublico)}")</RadzenText>
                                </RadzenColumn>
                        </RadzenRow>
                        
                        </RadzenStack>
                    </RadzenStack>
                    
                    <RadzenStack Orientation="Orientation.Vertical" Style="margin-top:auto; padding:1px;">
                        <RadzenRow Style="margin-top:auto; padding:1px;">
                            <RadzenColumn Size="6" Style="margin-top:auto; padding:1px;">
                                <RadzenButton Click=@(args => AddToCart(articulo)) Text="Agregar" ButtonStyle="ButtonStyle.Info" Style="width:100%; height:20px; font-size:12px;border-radius: 0" Variant="Variant.Outlined"/>
                            </RadzenColumn>
                            <RadzenColumn Size="6" Style="margin-top:auto; padding:1px;">
                                <RadzenNumeric @bind-Value="articulo.Cantidad" Min="0" Max="100" Step="1" Placeholder="Enter a number between 0 and 100" 
                                        Style="width:100%; height:35px; font-size:12px;border-radius: 0"/>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenStack>
                </RadzenCard>
            </Template>
        </RadzenDataList>
        <RadzenPager ShowPagingSummary="true" PagingSummaryFormat="@pagingSummaryFormat" HorizontalAlign="HorizontalAlign.Right" Count="count" PageSize="@pageSize" PageNumbersCount="5" PageChanged="@PageChanged" />
    </RadzenColumn>
    
    <RadzenColumn Size="4">
        <RadzenCard Style="position: sticky; top: 20px; max-height: 80vh; overflow-y: auto;">
                <RadzenStack>
                    <RadzenText TextStyle="TextStyle.H5" Text="Carrito de Compras" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@($"{CartService.TotalItems} artículos")" />
                    
                    @if (CartService.Items.Any())
                    {
                        <RadzenStack Gap="0.5rem">
                            @foreach (var item in CartService.Items)
                            {
                                <RadzenRow AlignItems="AlignItems.Center">
                                    <RadzenColumn Size="7">
                                        <RadzenText TextStyle="TextStyle.Caption" Text="@item.Descripcion" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="2">
                                                <RadzenNumeric @bind-Value="item.Cantidad" 
                                                            Min="1" 
                                                            Change="@((int value) => UpdateQuantity(item.ArticuloId, value))" 
                                                            TextStyle="TextStyle.Caption" 
                                                            Style="--rz-input-font-size: small; --rz-input-height: 24px;" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="1" class="rz-text-align-end">
                                        <RadzenButton Icon="delete" 
                                                    ButtonStyle="ButtonStyle.Danger" 
                                                    Size="ButtonSize.ExtraSmall" 
                                                    Click="@(args => RemoveFromCart(item.ArticuloId))" />
                                    </RadzenColumn>
                                    <RadzenColumn Size="2" class="rz-text-align-end">   
                                        <RadzenText TextStyle="TextStyle.Caption" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", item.Total)}")" />
                                    </RadzenColumn>
                                </RadzenRow>
                            }
                        </RadzenStack>
                        
                        <div style="border-top: 1px solid #ccc; margin: 0.5rem 0;"></div>
                        
                        <RadzenStack Gap="0.25rem">
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Body2" Text="Subtotal:" />
                                </RadzenColumn>
                                <RadzenColumn Size="6" class="rz-text-align-end">
                                    <RadzenText TextStyle="TextStyle.Body2" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", CartService.Subtotal)}")" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.Body2" Text="Impuestos:" />
                                </RadzenColumn>
                                <RadzenColumn Size="6" class="rz-text-align-end">
                                    <RadzenText TextStyle="TextStyle.Body2" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", CartService.TotalImpuestos)}")" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow>
                                <RadzenColumn Size="6">
                                    <RadzenText TextStyle="TextStyle.H6" Text="Total:" />
                                </RadzenColumn>
                                <RadzenColumn Size="6" class="rz-text-align-end">
                                    <RadzenText TextStyle="TextStyle.H6" Text="@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", CartService.Total)}")" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                        
                        <div style="border-top: 1px solid #ccc; margin: 0.5rem 0;"></div>
                        
                        <RadzenStack>
                            <RadzenButton Text="Procesar Venta" 
                                        ButtonStyle="ButtonStyle.Success" 
                                        Click="@ProcessSale" 
                                        Style="width: 100%;" />
                            <RadzenButton Text="Limpiar Carrito" 
                                        ButtonStyle="ButtonStyle.Light" 
                                        Click="@ClearCart" 
                                        Style="width: 100%;" />
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Text="El carrito está vacío" class="rz-text-align-center" />
                    }
                </RadzenStack>
            </RadzenCard>
    </RadzenColumn>
</RadzenRow>


@code {

    string pagingSummaryFormat = "Presentando página {0} de {1} (total {2} registros)";
    int pageSize = 4;
    int count;
    string searchText = "";
    protected IEnumerable<ArticuloListarDTO>? articulos;
   
    
    protected override void OnInitialized()
    {
        CartService.OnCartChanged += StateHasChanged;
    }
    
    public void Dispose()
    {
        CartService.OnCartChanged -= StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            Result<IEnumerable<ArticuloListarDTO>> result = await _mediator.Send(new ListArticulosQuery(null,0, pageSize));
            if (result.IsSuccess)
            {
                articulos = result.Value;
                count = articulos?.Count() ?? 0;
                if (count == 0)
                {
                    NotificationService.Notify(new NotificationMessage 
                    { 
                        Severity = NotificationSeverity.Info, 
                        Summary = "Información", 
                        Detail = "No se encontraron artículos." 
                    });
                }
                else
                {
                    NotificationService.Notify(new NotificationMessage 
                    { 
                        Severity = NotificationSeverity.Success, 
                        Summary = "Éxito", 
                        Detail = $"{count} artículos cargados." 
                    });
                }
            }
            else
            {
                NotificationService.Notify(new NotificationMessage 
                { 
                    Severity = NotificationSeverity.Error, 
                    Summary = "Error", 
                    Detail = result.Errors.FirstOrDefault() 
                });
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error al cargar los artículos");
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = "No se pudieron cargar los artículos." });
        }
    }

    async Task PageChanged(PagerEventArgs args)
    {
         Result<IEnumerable<ArticuloListarDTO>> result = await _mediator.Send(new ListArticulosQuery(null,args.Skip, args.Top));
            if (result.IsSuccess)
            {
                articulos = result.Value;
            }
    }

    private void AddToCart(ArticuloListarDTO articulo)
    {
        CartService.AddItem(articulo);
        NotificationService.Notify(new NotificationMessage 
        { 
            Severity = NotificationSeverity.Success, 
            Summary = "Agregado", 
            Detail = $"{articulo.Descripcion} agregado al carrito" 
        });
    }
    
    private void RemoveFromCart(Guid articuloId)
    {
        CartService.RemoveItem(articuloId);
        NotificationService.Notify(new NotificationMessage 
        { 
            Severity = NotificationSeverity.Info, 
            Summary = "Removido", 
            Detail = "Artículo removido del carrito" 
        });
    }
    
    private void UpdateQuantity(Guid articuloId, int cantidad)
    {
        CartService.UpdateQuantity(articuloId, cantidad);
    }
    
    private void ClearCart()
    {
        CartService.Clear();
        NotificationService.Notify(new NotificationMessage 
        { 
            Severity = NotificationSeverity.Info, 
            Summary = "Carrito", 
            Detail = "Carrito limpiado" 
        });
    }
    
    private void ProcessSale()
    {
        NotificationService.Notify(new NotificationMessage 
        { 
            Severity = NotificationSeverity.Info, 
            Summary = "Venta", 
            Detail = $"Procesando venta por {String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", CartService.Total)}" 
        });
    }

     async Task Search()
    {
        // Implementar la lógica de búsqueda según la categoría seleccionada
        try
        {
            Result<IEnumerable<ArticuloListarDTO>> result = await _mediator.Send(new ListArticulosQuery(searchText,null, null));
            if (result.IsSuccess)
            {
                articulos = result.Value;
                count = articulos?.Count() ?? 0;
                if (count == 0)
                {
                    NotificationService.Notify(new NotificationMessage 
                    { 
                        Severity = NotificationSeverity.Info, 
                        Summary = "Información", 
                        Detail = "No se encontraron artículos." 
                    });
                }
                else
                {
                    NotificationService.Notify(new NotificationMessage 
                    { 
                        Severity = NotificationSeverity.Success, 
                        Summary = "Éxito", 
                        Detail = $"{count} artículos cargados." 
                    });
                }
            }
            else
            {
                NotificationService.Notify(new NotificationMessage 
                { 
                    Severity = NotificationSeverity.Error, 
                    Summary = "Error", 
                    Detail = result.Errors.FirstOrDefault() 
                });
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error al cargar los artículos");
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = "No se pudieron cargar los artículos." });
        } 
       
               
        
    }
}