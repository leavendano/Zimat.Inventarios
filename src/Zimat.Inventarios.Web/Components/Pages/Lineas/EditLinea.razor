@page "/edit-lineas"
@using MediatR
@using Zimat.Inventarios.UseCases.Lineas.Get
@using Zimat.Inventarios.UseCases.Lineas.Update
@inject IMediator _mediator
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ILogger<EditLinea> logger

<PageTitle>Editar Línea</PageTitle>
<RadzenColumn SizeMD=12>
    <RadzenAlert Shade="Shade.Lighter" Variant="Variant.Flat" Size="AlertSize.Small" AlertStyle="AlertStyle.Danger" Visible="@errorVisible">@mensajeAlerta</RadzenAlert>
    <RadzenTemplateForm TItem="LineaDTO" Data="@linea" Visible="@(linea != null)" Submit="@FormSubmit">
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Descripción" Component="descripcion" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenTextBox style="display: block; width: 100%" @bind-Value="@linea!.Descripcion" Name="descripcion" />
                <RadzenRequiredValidator Component="descripcion" Text="La descripción es requerida" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow style="margin-bottom: 1rem">
            <RadzenColumn SizeMD="3">
                <RadzenLabel Text="Margen %" Component="margen" style="width: 100%" />
            </RadzenColumn>
            <RadzenColumn SizeMD="9">
                <RadzenNumeric style="display: block; width: 100%" @bind-Value="@linea!.Margen" Name="margen" Min="0" Max="100" Step="0.01" />
                <RadzenRequiredValidator Component="margen" Text="El margen es requerido" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Icon="save" Text="Guardar" Variant="Variant.Flat" />
            <RadzenButton ButtonStyle="ButtonStyle.Light" Text="Cancelar" Variant="Variant.Flat" Click="@CancelButtonClick" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenColumn>

@code{
    protected class LineaDTO
    {
        public Guid Id { get; set; }
        public string Descripcion { get; set; } = string.Empty;
        public decimal Margen { get; set; } = 0;
    }

    [Parameter]
    public Guid Id { get; set; }
    
    [Parameter] public EventCallback OnLineaUpdated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await _mediator.Send(new GetLineaQuery(Id));
        if (result.IsSuccess)
        {
            linea.Id = result.Value.Id;
            linea.Descripcion = result.Value.Descripcion;
            linea.Margen = result.Value.Margen;
        }
        else
        {
            mensajeAlerta = "No se pudo cargar la línea";
            errorVisible = true;
        }
    }
    
    protected bool errorVisible;
    protected string mensajeAlerta = "No se pudo guardar el registro";
  
    protected LineaDTO linea { get; set; } = new();

    protected async Task FormSubmit()
    {
        try
        {
            var result = await _mediator.Send(new UpdateLineaCommand(linea.Id, linea.Descripcion, linea.Margen));
            
            if (result.IsSuccess)
            {
                NotificationService.Notify(new NotificationMessage 
                { 
                    Severity = NotificationSeverity.Success,
                    Summary = "Línea actualizada",
                    Detail = "La línea se ha actualizado correctamente",
                    Duration = 4000 
                });
                
                if (OnLineaUpdated.HasDelegate)
                {
                    await OnLineaUpdated.InvokeAsync();
                }
                
                DialogService.Close(linea);
            }
            else
            {
                mensajeAlerta = "No se pudo actualizar la línea";
                errorVisible = true;
            }
        }
        catch (Exception e)
        {
            NotificationService.Notify(new NotificationMessage 
            { 
                Severity = NotificationSeverity.Error,
                Summary = "Error al actualizar la línea",
                Detail = e.Message,
                Duration = 4000 
            });
            mensajeAlerta = $"Error: {e.Message}";
            errorVisible = true;
            logger.LogError(e, "Error al actualizar la línea");
        }
    }

    protected async Task CancelButtonClick(MouseEventArgs args)
    {
        await Task.Run(() => DialogService.Close(null));
    }
}